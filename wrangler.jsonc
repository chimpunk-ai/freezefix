{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freezefix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Anything set in the Cloudflare dashboard survives a deploy from GitHub.
  // Without this, `wrangler deploy` overwrites dashboard variables with whatever is in this
  // file, which is nothing, so the API key vanished on the next push.
  "keep_vars": true
  // Secrets (ANTHROPIC_API_KEY, SUPABASE_URL, SUPABASE_ANON_KEY) are added in the
  // Cloudflare dashboard, never in this file.
}
