# Copy this file to .dev.vars for local testing. NEVER commit real keys.
# On Cloudflare, add these as Secrets in the dashboard instead.

# AI (leave empty to use the safe built-in moves while testing)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Anonymous counts only (risk level, "Did it help?"). Leave empty to turn logging off.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Voice notes (Budget & Ops picks the provider, HQ T33). Any OpenAI-style transcription API.
# Leave empty and the voice button stays hidden.
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Random secret used to hash device IDs and IPs for the daily limits. Any long random text.
QUOTA_SALT=
# Optional: screenshot cost guard per day (free / paid).
SCREENSHOT_DAILY_LIMIT=10
SCREENSHOT_DAILY_LIMIT_PAID=20

# Switches for optional inputs. Keep "false" until HQ T31, T32 and T33 are Done.
ENABLE_SCREENSHOTS=false
ENABLE_VOICE=false

# Payments: Paddle Billing (merchant of record). Budget & Ops sets up the account.
# Both prices need a 4-day free trial set in Paddle. Client token is public; the rest are secret.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_YEARLY=
PADDLE_PRICE_MONTHLY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
# Used ONLY by the payment webhook to save subscriptions.
SUPABASE_SERVICE_ROLE_KEY=
